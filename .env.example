DATABASE_URL=jdbc:postgresql://localhost:5432/local-db
DATABASE_USERNAME=local-user
DATABASE_PASSWORD=local-password

ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8081

STEAM_RATE_LIMIT_LIMIT_FOR_PERIOD=1000
STEAM_RATE_LIMIT_REFRESH_PERIOD=1m
STEAM_RATE_LIMIT_TIMEOUT_DURATION=0

PRAYER_TIMES_RATE_LIMIT_LIMIT_FOR_PERIOD=1000
PRAYER_TIMES_RATE_LIMIT_REFRESH_PERIOD=1m
PRAYER_TIMES_RATE_LIMIT_TIMEOUT_DURATION=0

STEAM_API_KEY=<key_here>
STEAM_USER_ID=<user_ID_here>

LOGGING_SNS_ARN=<arn_here>
LOGGING_SNS_REGION=eu-west-1
LOGGING_SNS_MAX_MESSAGE_LENGTH=8000